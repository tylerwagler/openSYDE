/* --------------------------------------------------------------------- */
stw--opensyde_gui_elements--C_OgeGbxStyled[variant="Default"]
{
border-width: 1px;
border-style: solid;
border-radius: 0px;
}

/* --------------------------------------------------------------------- */
stw--opensyde_gui_elements--C_OgeGbxStyled[variant="Default"]NavigationSection,
stw--opensyde_gui_elements--C_OgeGbxStyled[variant="Default"]NavigationTab
{
border-bottom-width: 0px;
border-top-width: 1px;
border-right-width: 0px;
border-style: solid;
border-radius: 0px;
}

/* --------------------------------------------------------------------- */
stw--opensyde_gui_elements--C_OgeGbxStyled[variant="Default"]NavigationTab[IncludeLeftBorder="true"]
{
border-left-width: 1px;
}

stw--opensyde_gui_elements--C_OgeGbxStyled[variant="Default"]NavigationSection,
stw--opensyde_gui_elements--C_OgeGbxStyled[variant="Default"]NavigationTab[IncludeLeftBorder="false"]
{
border-left-width: 0px;
}

/* --------------------------------------------------------------------- */

stw--opensyde_gui_elements--C_OgeGbxStyled[variant="Default"]NavigationSection2
{
border-left-width: 1px;
border-bottom-width: 0px;
border-top-width: 0px;
border-right-width: 0px;
border-style: solid;
border-radius: 0px;
}

/* --------------------------------------------------------------------- */

stw--opensyde_gui_elements--C_OgeGbxStyled[variant="Default"]NavigationSectionSelected
{
border-left-width: 0px;
border-bottom-width: 2px;
border-top-width: 2px;
border-right-width: 0px;
border-style: solid;
border-radius: 0px;
}

/* --------------------------------------------------------------------- */
stw--opensyde_gui_elements--C_OgeGbxStyled[variant="Default"]Grayed,
stw--opensyde_gui_elements--C_OgeGbxStyled[variant="Default"]TransparentToolBarSearch,
stw--opensyde_gui_elements--C_OgeGbxStyled[variant="Default"]Hover,
stw--opensyde_gui_elements--C_OgeGbxStyled[variant="Default"]ListHeader
{
border-style: solid;
border-width: 1px;
border-radius: 0px;
}

/* --------------------------------------------------------------------- */
stw--opensyde_gui_elements--C_OgeGbxStyled[variant="Default"]GrayedEdit
{
border-style: solid;
border-width: 1px;
border-radius: 0px;
}

/* --------------------------------------------------------------------- */
stw--opensyde_gui_elements--C_OgeGbxStyled[variant="Default"]Read,
stw--opensyde_gui_elements--C_OgeGbxStyled[variant="Default"]Transparent,
stw--opensyde_gui_elements--C_OgeGbxStyled[variant="Default"]TransparentDashboard,
stw--opensyde_gui_elements--C_OgeGbxStyled[variant="Default"]NavigationHeadingBackground
{
border-style: solid;
border-width: 0px;
border-radius: 0px;
}

/* --------------------------------------------------------------------- */
stw--opensyde_gui_elements--C_OgeGbxStyled[variant="Default"]ToolTip
{
border-style: solid;
border-width: 1px;
padding-top: 0px;
padding-left: 10px;
padding-right: 10px;
padding-bottom:0px;
}

/* --------------------------------------------------------------------- */
stw--opensyde_gui_elements--C_OgeGbxStyled[variant="Default"]MouseMove
{
border-style: solid;
border-width: 3px;
border-top-width: 22px;
}
