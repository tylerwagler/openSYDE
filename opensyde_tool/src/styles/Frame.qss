/* --------------------------------------------------------------------- */
QFrame[styleRole="fra-frame"],
stw--opensyde_gui_elements--C_OgeFraGeneric
{
border-width: 1px;
border-style: solid;
}

QFrame#pc_FrameApplicationWidget
{
border-width: 1px;
border-style: solid;
}

/* --------------------------------------------------------------------- */
QFrame[styleRole="fra-frame"][OpenRight="true"]
{
border-right-width: 0px;
}

QFrame[styleRole="fra-frame"][NoBorder="true"]
{
border-width: 0px;
}

QFrame#pc_FrameSdNdeDpSelectorItem
{
border-style: solid;
border-width: 1px;
}
/* --------------------------------------------------------------------- */
