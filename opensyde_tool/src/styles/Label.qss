/* --------------------------------------------------------------------- */
stw--opensyde_gui_elements--C_OgeLabDashboardTab
{
border-style: none;
}

/* --------------------------------------------------------------------- */
stw--opensyde_gui_elements--C_OgeLabPopUpTitle[styleRole="popup-title"]
{
padding-left: 20px;
padding-top: 15px;
padding-right: 0px;
padding-bottom: 15px;
}

stw--opensyde_gui_elements--C_OgeLabPopUpTitle[styleRole="popup-sub-title"]
{
padding-left: 0px;
padding-top: 15px;
padding-right: 0px;
padding-bottom: 15px;
}

/* --------------------------------------------------------------------- */
QLabel[styleRole="toolbox-heading-group-big"],
QLabel[styleRole="toolbox-heading-group"]
{
padding-top: 10px;
padding-left: 10px;
}

/* --------------------------------------------------------------------- */
QLabel[styleRole="node-prop-com-if-table"][COMIF_TableCell_Hyperlink="true"]:enabled,
QPushButton[styleRole="text-only"][Edit_Hyperlink="true"]:enabled
{
text-decoration: underline;
}

/* --------------------------------------------------------------------- */
QLabel[styleRole="dashboard-label-caption"]
{
padding: 4px;
}

/* --------------------------------------------------------------------- */
stw--opensyde_gui_elements--C_OgeMuSections QLabel
{
padding: 5px;
}

/* --------------------------------------------------------------------- */
stw--opensyde_gui_elements--C_OgeLabGenericNoPaddingNoMargins[styleRole="generic-bubble"],
stw--opensyde_gui_elements--C_OgeLabGenericWithContextMenu[Padding="1"]
{
margin-top: 1px;
padding-left: 2px;
padding-top: 0px;
padding-right: 1px;
padding-bottom: 0px;
border-radius: 2px;
}

/* --------------------------------------------------------------------- */
QLabel[styleRole="color-only"]
{
border-radius: 9px;
}
