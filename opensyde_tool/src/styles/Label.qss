/* --------------------------------------------------------------------- */
stw--opensyde_gui_elements--C_OgeLabStyledToolTip[variant="DashboardTab"]
{
border-style: none;
}

/* --------------------------------------------------------------------- */
stw--opensyde_gui_elements--C_OgeLabPopUpTitle
{
padding-left: 20px;
padding-top: 15px;
padding-right: 0px;
padding-bottom: 15px;
}

stw--opensyde_gui_elements--C_OgeLabPopUpSubTitle
{
padding-left: 0px;
padding-top: 15px;
padding-right: 0px;
padding-bottom: 15px;
}

/* --------------------------------------------------------------------- */
stw--opensyde_gui_elements--C_OgeLabStyled[variant="ToolboxHeadingGroup"]Big,
stw--opensyde_gui_elements--C_OgeLabStyled[variant="ToolboxHeadingGroup"]
{
padding-top: 10px;
padding-left: 10px;
}

/* --------------------------------------------------------------------- */
stw--opensyde_gui_elements--C_OgeLabStyled[variant="NodePropComIfTable"][COMIF_TableCell_Hyperlink="true"]:enabled
{
text-decoration: underline;
}

/* --------------------------------------------------------------------- */
stw--opensyde_gui_elements--C_OgeLabStyled[variant="DashboardLabelCaption"]
{
padding: 4px;
}

/* --------------------------------------------------------------------- */
stw--opensyde_gui_elements--C_OgeMuSections QLabel
{
padding: 5px;
}

/* --------------------------------------------------------------------- */
stw--opensyde_gui_elements--C_OgeLabGenericBubble,
stw--opensyde_gui_elements--C_OgeLabGenericWithContextMenu[Padding="1"]
{
margin-top: 1px;
padding-left: 2px;
padding-top: 0px;
padding-right: 1px;
padding-bottom: 0px;
border-radius: 2px;
}

/* --------------------------------------------------------------------- */
stw--opensyde_gui_elements--C_OgeLabStyled[variant="ColorOnly"]
{
border-radius: 9px;
}
