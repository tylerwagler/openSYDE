/* --------------------------------------------------------------------- */
QPushButton
{
/* suppress dotted rectangle: */
outline: none;
}

/* --------------------------------------------------------------------- */
/* Base QPushButton styling */
QPushButton
{
/* suppress dotted rectangle: */
outline: none;
}

/* --------------------------------------------------------------------- */
/* C_OgePubBase with objectName="buttonAddSettings" (replaces C_CamOgePubSettingsAdd) */
QPushButton#buttonAddSettings,
stw--opensyde_gui_elements--C_OgePubStyledToolTip[variant="Configure"]
{
border-style: none;
}

QPushButton#buttonAddSettings
{
padding: 1px;
padding-left: 5px;
padding-right: 5px;
text-align: center;
}

/* --------------------------------------------------------------------- */
/* C_OgePubBase with objectName="buttonDarkBrowse" (replaces C_CamOgePubDarkBrowse) */
QPushButton#buttonDarkBrowse
{
border-style: solid;
border-width: 1px;
border-left-width: 0px;
}

/* --------------------------------------------------------------------- */
/* C_OgePubBase with objectName="buttonPathVariables" (replaces C_CamOgePubPathVariables) */
QPushButton#buttonPathVariables
{
border-style: solid;
border-width: 1px;
border-left-width: 0px;
border-right-width: 0px;
}

QPushButton#buttonPathVariables::menu-indicator
{
width: 0px;
}

/* --------------------------------------------------------------------- */
/* C_OgePubBase with objectName="buttonProjOp" or "buttonAbout" (replaces C_CamOgePubProjOp, C_CamOgePubAbout) */
QPushButton#buttonProjOp,
QPushButton#buttonAbout
{
border-style: solid;
border-width: 1px;
height: 28px;
padding-left: 10px;
padding-right: 10px;
}

QPushButton#buttonProjOp
{
padding-left: 50px;
}
/* --------------------------------------------------------------------- */

/* --------------------------------------------------------------------- */
stw--opensyde_gui_elements--C_OgePubProjAction
{
border-style: solid;
border-radius: 0px;
border-width: 1px;
}

/* --------------------------------------------------------------------- */
stw--opensyde_gui_elements--C_OgePubStyled[variant="Cancel"],
stw--opensyde_gui_elements--C_OgePubStyled[variant="Dialog"],
stw--opensyde_gui_elements--C_OgePubStyled[variant="MessageCancel"],
stw--opensyde_gui_elements--C_OgePubStyled[variant="MessageOk"]
{
border-style: solid;
border-radius: 2px;
border-width: 1px;
text-align: center;
min-height: 30px;
max-height: 30px;
padding-left: 15px;
padding-right: 15px;
}

stw--opensyde_gui_elements--C_OgePubStyled[variant="Cancel"]:focus,
stw--opensyde_gui_elements--C_OgePubStyled[variant="Dialog"]:focus,
stw--opensyde_gui_elements--C_OgePubStyled[variant="MessageOk"]:focus,
stw--opensyde_gui_elements--C_OgePubStyled[variant="MessageCancel"]:focus
{
text-decoration: underline;
}
