/* --------------------------------------------------------------------- */
/* STYLE_GUIDE */
/* --------------------------------------------------------------------- */
/* Order:                         */
/*    font size guide index       */
/*       - regular                */
/*       - semi-bold              */
/*       - bold                   */

/* --------------------------------------------------------------------- */
/* STYLE_GUIDE_FONT_NORMAL_10 */
stw--opensyde_gui_elements--C_OgeLabGenericNoPaddingNoMargins[Font="10"][SemiBold="false"][Bold="false"]
{
font-family:"Segoe UI";
font-size:10px;
font-weight:normal;
}

/* STYLE_GUIDE_FONT_BOLD_10 */
stw--opensyde_gui_elements--C_OgeLabGenericNoPaddingNoMargins[Font="10"][SemiBold="false"][Bold="true"]
{
font-family:"Segoe UI";
font-size:10px;
font-weight:bold;
}

/* --------------------------------------------------------------------- */
/* STYLE_GUIDE_FONT_REGULAR_11 */
stw--opensyde_gui_elements--C_OgeLabGenericNoPaddingNoMargins[Font="11"][SemiBold="false"][Bold="false"],
stw--opensyde_gui_elements--C_OgeTedPropertiesComment,
