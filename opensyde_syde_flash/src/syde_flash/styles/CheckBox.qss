/* --------------------------------------------------------------------- */
stw--opensyde_gui_elements--C_OgeChxToolTipBase[styleRole="cam-chx-settings"][NoText="true"]
{
spacing: 0px;
}

stw--opensyde_gui_elements--C_OgeChxToolTipBase[styleRole="cam-chx-settings"]::indicator,
stw--opensyde_gui_elements--C_OgeChxToolTipBase[styleRole="chx-properties"]::indicator
{
width: 14px;
height: 14px;
border: 1px solid;
padding: 2px;
}

stw--opensyde_gui_elements--C_OgeChxToolTipBase[styleRole="cam-chx-settings"]::indicator:checked:enabled,
stw--opensyde_gui_elements--C_OgeChxToolTipBase[styleRole="chx-properties"]::indicator:checked:enabled
{
image: url(://images/CheckBoxActiveWithoutBackground.svg);
}

stw--opensyde_gui_elements--C_OgeChxToolTipBase[styleRole="cam-chx-settings"]::indicator:checked:disabled
{
image: url(://images/CheckBoxActiveDisabledWithoutBackground.svg);
}

stw--opensyde_gui_elements--C_OgeChxToolTipBase[styleRole="chx-properties"]::indicator:checked:disabled
{
image: url(://images/CheckBoxDisabledGrayWithoutBackground.svg);
}
